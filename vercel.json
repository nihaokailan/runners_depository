{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=/$1"
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 30,
      "excludeFiles": "{backups/**,uploads/**,__pycache__/**,client_test.py,parser_test.py}"
    }
  }
}
